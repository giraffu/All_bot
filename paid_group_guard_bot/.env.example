# Token of the dedicated paid group guard bot from BotFather.
PAID_GROUP_BOT_TOKEN=

# Private paid group or supergroup id, usually starts with -100.
PAID_GROUP_CHAT_ID=-1000000000000

# Leave false at first to keep non-eligible requests pending for manual review.
PAID_GROUP_DECLINE_UNQUALIFIED=false

# Set true for a smoke test that only logs approve/decline decisions.
PAID_GROUP_DRY_RUN=false

# Reuse the same DB environment style as the main bot.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/bot_db
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2

# Optional: reuse the local Bot API server used by the main bot.
PAID_GROUP_BOT_BASE_URL=http://69.63.220.115:8081/bot
PAID_GROUP_BOT_BASE_FILE_URL=http://69.63.220.115:8082