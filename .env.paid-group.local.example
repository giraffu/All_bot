# Copy this file to .env.paid-group.local and fill the real values locally.
# Do not commit the real .env.paid-group.local file.

# Dedicated BotFather token for the paid-group guard bot.
PAID_GROUP_BOT_TOKEN=

# Private paid group or supergroup id, usually starts with -100.
PAID_GROUP_CHAT_ID=-1000000000000

# First local run should stay dry-run until the join request logs look right.
PAID_GROUP_DRY_RUN=true

# Keep unqualified users pending during local verification.
PAID_GROUP_DECLINE_UNQUALIFIED=false

# Local group moderation smoke test. Production can set dry-run to false.
PAID_GROUP_MODERATION_ENABLED=true
PAID_GROUP_MODERATION_DRY_RUN=true
PAID_GROUP_BLOCK_LINKS=true
PAID_GROUP_MODERATION_CONFIG_FILE=runtime/paid-group-guard-local/config.json
PAID_GROUP_MODERATION_LOG_FILE=logs/paid_group_moderation.local.jsonl

# Database reachable from the local container. With host networking,
# localhost points at the host network namespace.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/bot_db
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2

# Use the same Telegram Local API defaults as the main project config.
# PAID_GROUP_BOT_BASE_URL is intentionally left unset so the bot derives
# http://69.63.220.115:8081/bot from TELEGRAM_API_BASE_URL.
TELEGRAM_API_BASE_URL=http://69.63.220.115:8081
TELEGRAM_FILE_BASE_URL=http://69.63.220.115:8082

# Optional explicit overrides if the local Bot API address changes.
# PAID_GROUP_BOT_BASE_URL=http://69.63.220.115:8081/bot
# PAID_GROUP_BOT_BASE_FILE_URL=http://69.63.220.115:8082

PAID_GROUP_BOT_CONNECT_TIMEOUT=60
PAID_GROUP_BOT_READ_TIMEOUT=60
PAID_GROUP_BOT_WRITE_TIMEOUT=60
PAID_GROUP_BOT_POOL_SIZE=20
PAID_GROUP_BOT_POLL_INTERVAL=2
PAID_GROUP_BOT_POLL_TIMEOUT=30
