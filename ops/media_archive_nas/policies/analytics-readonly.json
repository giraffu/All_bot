{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::allbot-media-archive-v1", "arn:aws:s3:::allbot-media-derived-v1"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::allbot-media-archive-v1/*", "arn:aws:s3:::allbot-media-derived-v1/*"]
    }
  ]
}
