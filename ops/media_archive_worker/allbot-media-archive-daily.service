[Unit]
Description=AllBot media archive daily reconciliation and source status
After=network-online.target

[Service]
Type=oneshot
User=hfy
Group=hfy
WorkingDirectory=/home/hfy/APP/All_bot
EnvironmentFile=/home/hfy/.config/allbot/media-archive/worker.env
ExecStart=/home/hfy/miniconda3/bin/python scripts/media_archive_catalog.py sync-new
ExecStart=/home/hfy/miniconda3/bin/python scripts/media_archive_source_health.py --config /home/hfy/.config/allbot/media-archive/worker.json --output /var/lib/allbot-media-archive/state/source-health.json
ExecStart=/home/hfy/miniconda3/bin/python scripts/reconcile_media_archive_outbox.py --end-id 2147483647 --execute
ExecStart=/home/hfy/miniconda3/bin/python scripts/reconcile_media_archive_restore.py --limit 10000 --execute
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=allbot-media-archive
ReadWritePaths=/var/lib/allbot-media-archive
