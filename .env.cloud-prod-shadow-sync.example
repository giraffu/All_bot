# Cloud production to local shadow sync.
# Copy to .env.cloud-prod-shadow-sync.local and fill real credentials on the local host only.

# Cloud production PostgreSQL is read only for this job.
CLOUD_PROD_DATABASE_URL=postgresql://cloud_user:CHANGE_ME@cloud-prod-db.example.internal:5432/bot_db_prod?sslmode=require
SHADOW_SYNC_POSTGRES_IMAGE=postgres:18

# Recommended production path: run pg_dump on the cloud control machine, upload the
# dump to a temporary R2 prefix, download it locally over HTTPS, then restore it.
CLOUD_PROD_DB_DUMP_MODE=remote_r2
CLOUD_PROD_DB_REMOTE_DUMP_SSH_HOST=allbot-do-sgp1-control
CLOUD_PROD_DB_REMOTE_ROOT=/home/deploy/APP/All_bot
CLOUD_PROD_DB_REMOTE_ENV_FILE=/home/deploy/APP/All_bot/.env.cloud.prod
CLOUD_PROD_DB_REMOTE_DUMP_DIR=backups/cloud-prod-shadow
CLOUD_PROD_DB_REMOTE_TRANSFER_PREFIX=__shadow-transfer

# Optional fallback and Redis/Valkey summary probe path. The script opens
# short-lived SSH tunnels from local -> cloud control -> managed services.
CLOUD_PROD_DB_TUNNEL_SSH_HOST=allbot-do-sgp1-control
CLOUD_PROD_DB_TUNNEL_LOCAL_HOST=127.0.0.1
CLOUD_PROD_DB_TUNNEL_LOCAL_PORT=0
CLOUD_PROD_DB_TUNNEL_CONNECT_TIMEOUT_SECONDS=20

# Local maintenance DB URL; the script creates/restores/renames shadow databases through it.
LOCAL_POSTGRES_MAINTENANCE_URL=postgresql://local_admin:CHANGE_ME@127.0.0.1:5432/postgres
SHADOW_DATABASE_NAME=bot_db_prod_shadow
SHADOW_SYNC_BACKUP_ROOT=/home/hfy/APP/All_bot/backups/cloud-prod-shadow
SHADOW_SYNC_RETENTION_DAYS=14
# Preserve local analytics mart/slim/vector tables across daily shadow DB replacement.
LOCAL_ANALYTICS_PRESERVE_ON_SHADOW_SYNC=true

# Cloudflare R2 production bucket source.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY=CHANGE_ME
R2_SECRET_KEY=CHANGE_ME
R2_BUCKET=user-data-prod
R2_SYNC_BWLIMIT=20M
R2_SYNC_TRANSFERS=8
R2_SYNC_CHECKERS=16
# Set false for DB-only daily runs. remote_r2 DB dumps still use the
# temporary R2 __shadow-transfer prefix even when media bucket sync is off.
R2_BUCKET_SYNC_ENABLED=true
R2_SHADOW_SEED_WITH_COPY=false
# Optional local outbound proxy for the R2 HTTPS transfer. Keep local MinIO hosts
# in NO_PROXY so the bucket restore path stays on the LAN.
R2_SYNC_HTTP_PROXY=
R2_SYNC_HTTPS_PROXY=
R2_SYNC_NO_PROXY=127.0.0.1,localhost

# Local MinIO shadow target. Keep bucket names distinct from the production R2 bucket.
LOCAL_MINIO_ENDPOINT=http://127.0.0.1:9000
LOCAL_MINIO_ACCESS_KEY=CHANGE_ME
LOCAL_MINIO_SECRET_KEY=CHANGE_ME
LOCAL_MINIO_SHADOW_BUCKET=user-data-prod-shadow
LOCAL_MINIO_QUARANTINE_BUCKET=user-data-prod-shadow-quarantine

# Optional complete media bucket for offline disaster-recovery verification:
# daily runs copy the R2 shadow bucket into this bucket without deletion.
# Set false together with R2_BUCKET_SYNC_ENABLED=false for DB-only daily runs.
COMPLETE_MEDIA_SYNC_ENABLED=true
LOCAL_MINIO_COMPLETE_BUCKET=user-data-complete-shadow

# Optional: record Redis/Valkey summaries only; this job never restores runtime state.
# CLOUD_PROD_REDIS_URL=redis://:CHANGE_ME@cloud-prod-redis.example.internal:6379/0
# CLOUD_PROD_WORKER_REDIS_URL=redis://:CHANGE_ME@cloud-prod-worker-redis.example.internal:6379/0
