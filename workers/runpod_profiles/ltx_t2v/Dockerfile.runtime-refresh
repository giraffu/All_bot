ARG BASE_IMAGE=ghcr.io/giraffu/allbot-gpu-ltx-t2v@sha256:b956eb3ff3ee1518c92314a40d44b10d0734d91de5ed09cea05214df30511897
FROM ${BASE_IMAGE}

ARG ALLBOT_GIT_SHA
ARG ALLBOT_RUNTIME_PACKAGE_SHA256
ARG ALLBOT_WORKFLOW_MAPPING_SHA256
ARG RUNTIME_REQUIREMENTS_SHA256=d81a4ee4dc26db0deb2d554bd59b277dfae0bf9071454a5d955f8fff4925ed13
ENV ALLBOT_GIT_SHA=$ALLBOT_GIT_SHA \
    ALLBOT_RUNTIME_PACKAGE_SHA256=$ALLBOT_RUNTIME_PACKAGE_SHA256 \
    ALLBOT_WORKFLOW_MAPPING_SHA256=$ALLBOT_WORKFLOW_MAPPING_SHA256
LABEL org.opencontainers.image.revision=$ALLBOT_GIT_SHA \
      io.allbot.runpod.agent-revision=$ALLBOT_GIT_SHA \
      io.allbot.runpod.workflow-revision=$ALLBOT_GIT_SHA \
      io.allbot.runpod.runtime-base-digest="sha256:b956eb3ff3ee1518c92314a40d44b10d0734d91de5ed09cea05214df30511897"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN echo "${RUNTIME_REQUIREMENTS_SHA256}  /opt/allbot/runtime/runpod_worker/requirements.txt" | sha256sum -c - && rm -rf /opt/allbot/runtime/runpod_worker
COPY workers/runpod_runtime /opt/allbot/runtime/runpod_worker
COPY workers/comfy_agent /opt/allbot/runtime/runpod_worker/comfy_agent
COPY src /opt/allbot/runtime/runpod_worker/src
COPY shared /opt/allbot/runtime/runpod_worker/shared
RUN test -n "$ALLBOT_GIT_SHA" && \
    test -n "$ALLBOT_RUNTIME_PACKAGE_SHA256" && \
    test -n "$ALLBOT_WORKFLOW_MAPPING_SHA256" && \
    PYTHONPATH=/opt/allbot/runtime/runpod_worker python3 -c 'from comfy_agent.runtime_manifest import load_runtime_manifest; load_runtime_manifest();'
COPY workers/runpod_runtime/scripts/runpod_bootstrap_from_git.sh /opt/allbot/runpod_bootstrap_from_git.sh
COPY workers/runpod_runtime/scripts/runpod_baked_runtime_entrypoint.sh /opt/allbot/runpod_baked_runtime_entrypoint.sh
RUN echo "${RUNTIME_REQUIREMENTS_SHA256}  /opt/allbot/runtime/runpod_worker/requirements.txt" | sha256sum -c -
RUN PYTHONPATH=/opt/allbot/runtime/runpod_worker python3 -c 'from shared.character_reference_sheet import compose_ingredients_character_panel; assert callable(compose_ingredients_character_panel)'

RUN set -euo pipefail; \
    chmod +x /opt/allbot/runpod_bootstrap_from_git.sh /opt/allbot/runpod_baked_runtime_entrypoint.sh; \
    comfyui_dir="$(cat /opt/allbot-comfyui-dir)"; \
    test -f "${comfyui_dir}/main.py"; \
    for node_name in ComfyUI-KJNodes ComfyUI-LTXVideo ComfyUI-VideoHelperSuite allbot_ltx_min_nodes rgthree-comfy; do \
      test -d "${comfyui_dir}/custom_nodes/${node_name}"; \
    done; \
    python3 -c 'import fastapi, minio, uvicorn, websockets'; \
    PYTHONPATH=/opt/allbot/runtime/runpod_worker python3 -c 'from comfy_agent.workflow_task_patchers import TASK_SPECIFIC_PATCHERS as p; assert {"ltx_t2v","ltx_t2v_ic"} <= set(p)'; \
    python3 -c 'import json; from pathlib import Path; root=Path("/opt/allbot/runtime/runpod_worker/comfy_agent/workflows"); t2v=json.loads((root/"LTX 2.3 Sulphur T2V.json").read_text()); ic=json.loads((root/"LTX 2.3 Sulphur Ingredients T2V.json").read_text()); assert t2v["26:39"]["inputs"]["width"] == 640; assert t2v["26:91"]["inputs"]["latent"] == ["26:95",0]; assert ic["26:39"]["inputs"]["width"] == ["5100",0]; assert ic["198"]["inputs"]["latent"] == ["26:39",0] and ic["115"]["inputs"]["latent"] == ["198",0]'; \
    if find "${comfyui_dir}/models" -type f -name "*.safetensors" -print -quit | grep -q .; then \
      echo "LTX model files must stay out of the runtime refresh image" >&2; \
      exit 1; \
    fi

ENV ALLBOT_RUNPOD_REPO_DIR=/opt/allbot/runtime \
    ALLBOT_RUNPOD_WORKER_DIR=/opt/allbot/runtime/runpod_worker
CMD ["bash", "/opt/allbot/runpod_baked_runtime_entrypoint.sh"]
