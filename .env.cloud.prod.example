# Cloud production control-plane environment template.
# Copy to .env.cloud.prod and replace every placeholder before running scripts.

BOT_TYPE=PROD
REDIS_PREFIX=prod_bot_
MEMBERSHIP_SETTLEMENT_V2_ENABLED=true
AFFILIATE_MEMBERSHIP_REDEEM_ENABLED=true
CLOUD_PROD_BIND_IP=100.107.220.127
CLOUD_PROD_TAILSCALE_IP=100.107.220.127
DASHBOARD_FRONTEND_PORT=8086
QQCC_CONFIG_FRONTEND_PORT=8088

DATABASE_URL=postgresql+asyncpg://<user>:<password>@<do-pg-host>:25060/bot_db_prod?ssl=require
CLOUD_PROD_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<do-pg-host>:25060/bot_db_prod?ssl=require
CLOUD_PROD_DATABASE_URL_SYNC=postgresql://<user>:<password>@<do-pg-host>:25060/bot_db_prod?sslmode=require

REDIS_URL=rediss://default:<password>@<do-valkey-host>:25061/1
WORKER_REDIS_URL=rediss://default:<password>@<do-valkey-host>:25061/2
CLOUD_PROD_REDIS_URL=rediss://default:<password>@<do-valkey-host>:25061/1
CLOUD_PROD_WORKER_REDIS_URL=rediss://default:<password>@<do-valkey-host>:25061/2

API_BASE=http://central-api-prod:8003
API_TOKEN=<same-random-central-token>
AUTH_TOKEN=<same-random-central-token>
AGENT_SECRET_TOKEN=<shared-worker-auth-token>
JWT_SECRET_KEY=<web-jwt-secret>

# Optional hot-path polling/cache controls. Defaults are conservative for prod.
TASK_STATUS_CACHE_TTL_SECONDS=2.0
TASK_STATUS_CACHE_STALE_SECONDS=4.0
TASK_STATUS_CACHE_MAX_ENTRIES=5000
TASK_STREAM_STATUS_CACHE_TTL_SECONDS=2.0
TASK_STREAM_STATUS_CACHE_MAX_ENTRIES=5000
TASK_STREAM_PENDING_STATUS_POLL_INITIAL_SECONDS=5.0
TASK_STREAM_PENDING_STATUS_POLL_MAX_SECONDS=20.0
TASK_STREAM_RUNNING_STATUS_POLL_INITIAL_SECONDS=10.0
TASK_STREAM_RUNNING_STATUS_POLL_MAX_SECONDS=20.0
TASK_STREAM_STATUS_POLL_BACKOFF_MULTIPLIER=2.0
DASHBOARD_BACKEND_TASK_STATUS_CACHE_TTL_SECONDS=5.0
DASHBOARD_BACKEND_TASK_STATUS_CACHE_MAX_ENTRIES=2000
BOT_STATUS_POLL_INITIAL_INTERVAL=5
BOT_STATUS_POLL_MAX_INTERVAL=20

MINIO_ENDPOINT=<r2-s3-endpoint-host>
MINIO_ACCESS_KEY=<r2-token-access-key>
MINIO_SECRET_KEY=<r2-token-secret-key>
MINIO_BUCKET=user-data-prod
MINIO_INPUT_BUCKET=user-data-prod
MINIO_RESULT_BUCKET=user-data-prod
MINIO_TEMPLATE_BUCKET=user-data-prod
MINIO_SECURE=true
MINIO_PUBLIC_URL=

R2_ENDPOINT=https://<r2-s3-endpoint-host>
R2_ACCESS_KEY=<r2-token-access-key>
R2_SECRET_KEY=<r2-token-secret-key>
R2_BUCKET=user-data-prod
R2_PUBLIC_DOMAIN=https://r2.aivison.it.com

PAYMENT_API_PORT=8021
HUANYUY_PID=<huanyuy-pid>
HUANYUY_KEY=<huanyuy-key>
HUANYUY_GATEWAY=<huanyuy-gateway-url>
HUANYUY_NOTIFY_URL=https://rmb.aivison.it.com/api/pay/notify/huanyuy
HUANYUY_RETURN_URL=https://rmb.aivison.it.com/pay/result
HUANYUY_SITENAME=合欢宗账房
TON_PAYMENT_POLLING_ENABLED=true

MINI_APP_URL=https://web.aivison.it.com/
VITE_MERCHANT_ADDRESS=<ton-merchant-address>

BOT_TOKEN=<prod-bot-token>
QQCC_BOT_TOKEN=<qqcc-bot-token>
SUPPORT_BOT_TOKEN=<support-bot-token>
MAIN_BOT_LAZY_BOT_ENABLED=true
MAIN_BOT_LAZY_BOT_USERNAME=@QQCC666_bot
QQCC_MAIN_BOT_URL=https://t.me/<main-bot-username>
FILE_BOT_TOKEN=<prod-file-bot-token>
TELEGRAM_API_BASE_URL=http://69.63.220.115:8081
TELEGRAM_FILE_API_BASE_URL=http://69.63.220.115:8082
REQUIRED_CHANNEL_ID=<required-channel-id>
CHANNEL_INVITE_LINK=https://t.me/AiVisionAV
REFUGE_GROUP_ID=<refuge-group-id>
REFUGE_INVITE_LINK=<refuge-invite-link>

DASHBOARD_ADMIN_USERNAME=<dashboard-admin-user>
DASHBOARD_ADMIN_PASSWORD_HASH=<bcrypt-password-hash>
DASHBOARD_SECRET_KEY=<dashboard-jwt-secret>
QQCC_CONFIG_ADMIN_USERNAME=<qqcc-config-admin-user>
QQCC_CONFIG_ADMIN_PASSWORD_HASH=<bcrypt-password-hash>
QQCC_CONFIG_SECRET_KEY=<qqcc-config-jwt-secret>
QQCC_CONFIG_ADMIN_HOST=qqcc-admin.aivison.it.com

# QQCC user-owned Bot platform. Generate independent 32-byte URL-safe Base64
# values for each AES/HMAC key and a separate high-entropy owner JWT secret.
PRIVATE_QQCC_BOT_ENABLED=false
PRIVATE_QQCC_BOT_OWNER_HOST=private-bot.aivison.it.com
PRIVATE_QQCC_BOT_OWNER_WEBAPP_URL=https://private-bot.aivison.it.com/
PRIVATE_QQCC_BOT_OWNER_JWT_SECRET=<urlsafe-base64-32-byte-owner-jwt-key>
PRIVATE_QQCC_BOT_WEBHOOK_BASE_URL=https://api.aivison.it.com/api/private-bots/webhook
PRIVATE_QQCC_BOT_TOKEN_KEYRING='{"1":"<urlsafe-base64-32-byte-aes-key>"}'
PRIVATE_QQCC_BOT_TOKEN_ACTIVE_KEY_VERSION=1
PRIVATE_QQCC_BOT_TOKEN_FINGERPRINT_KEY=<urlsafe-base64-32-byte-hmac-key>
PRIVATE_QQCC_BOT_FORBIDDEN_BOT_IDS=<comma-separated-official-bot-numeric-ids>
PRIVATE_QQCC_BOT_TELEGRAM_API_BASE_URL=https://api.telegram.org
PRIVATE_QQCC_BOT_TELEGRAM_FILE_BASE_URL=https://api.telegram.org/file/bot
PRIVATE_QQCC_BOT_TELEGRAM_TRUSTED_HOSTS=

# Optional private Bot worker tuning. The compose profile is never enabled by
# the default production deploy path.
PRIVATE_QQCC_BOT_WORKER_CONSUMER_GROUP=private-qqcc-bot-workers
PRIVATE_QQCC_BOT_WORKER_CONCURRENCY=16
PRIVATE_QQCC_BOT_WORKER_BATCH_SIZE=50
PRIVATE_QQCC_BOT_WORKER_BLOCK_MS=1000
PRIVATE_QQCC_BOT_WORKER_PENDING_IDLE_MS=60000
PRIVATE_QQCC_BOT_WORKER_RETRY_SECONDS=1
PRIVATE_QQCC_BOT_WORKER_PENDING_SWEEP_SECONDS=30
PRIVATE_QQCC_BOT_APPLICATION_IDLE_SECONDS=300
PRIVATE_QQCC_BOT_ADMISSION_TIMEOUT_SECONDS=300
PRIVATE_QQCC_BOT_ZOMBIE_SWEEP_SECONDS=600
PRIVATE_QQCC_BOT_METRICS_PUBLISH_SECONDS=15
PRIVATE_QQCC_BOT_WORKER_MAX_INFLIGHT_UPDATES=64
PRIVATE_QQCC_BOT_WORKER_PER_BOT_PREFETCH=8
PRIVATE_QQCC_BOT_WORKER_MAX_DEFERRED_UPDATES=1024
PRIVATE_QQCC_BOT_SUBMISSION_RETENTION_DAYS=90

DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
R2_MAX_POOL_CONNECTIONS=64
R2_HEAD_SEMAPHORE_LIMIT=16

# Manual RunPod prod worker pool. Secret values should be stored as RunPod
# secret refs, not literal production keys.
RUNPOD_API_KEY=<runpod-api-key-for-manual-ops>
RUNPOD_DRY_RUN=true
RUNPOD_AUTOSCALER_ENABLED=false
RUNPOD_CLOUD_PROD_CENTRAL_API_URL=https://worker-central.aivison.it.com
RUNPOD_PROD_AGENT_ID=runpod_prod_img2img_manual_01
RUNPOD_PROD_SUPPORTED_TASK_TYPES=img2img,img2img_lora
RUNPOD_PROD_GPU_TYPE_IDS=NVIDIA GeForce RTX 4090
RUNPOD_PROD_MAX_MANUAL_SLOTS=100
RUNPOD_PROD_NODE_ID=runpod-cloud-prod
RUNPOD_PROD_BUCKET=user-data-prod
RUNPOD_PROD_AGENT_SECRET_TOKEN_REF={{ RUNPOD_SECRET_allbot_cloud_prod_agent_secret_token }}
RUNPOD_PROD_R2_ACCESS_KEY_REF={{ RUNPOD_SECRET_allbot_cloud_prod_r2_access_key }}
RUNPOD_PROD_R2_SECRET_KEY_REF={{ RUNPOD_SECRET_allbot_cloud_prod_r2_secret_key }}
RUNPOD_MODEL_BUCKET=allbot-model-cache
RUNPOD_MODEL_ENDPOINT=<r2-model-cache-s3-endpoint-host>
RUNPOD_MODEL_ACCESS_KEY_REF={{ RUNPOD_SECRET_allbot_model_cache_r2_access_key }}
RUNPOD_MODEL_SECRET_KEY_REF={{ RUNPOD_SECRET_allbot_model_cache_r2_secret_key }}

# Wan22 split-video prod RunPod profiles. These must not inherit the legacy
# WAN22_AIO template/image because FL_RIFE requires the baked rife49.pth cache.
RUNPOD_DOCKER_START_CMD_JSON_IMAGE_TO_VIDEO='["bash","-lc","exec bash /opt/allbot/runpod_bootstrap_from_git.sh"]'
RUNPOD_IMAGE_NAME_IMAGE_TO_VIDEO=ghcr.io/giraffu/allbot-comfy-runpod-wan22-aio-video:20260619-wan22aio-rife-bcf3ebd
RUNPOD_USE_TEMPLATE_IMAGE_TO_VIDEO=false
RUNPOD_MODEL_PREFIX_IMAGE_TO_VIDEO=image_to_video/2026-06-13-test
RUNPOD_MODEL_MANIFEST_KEY_IMAGE_TO_VIDEO=image_to_video/2026-06-13-test/manifest.json
RUNPOD_DOCKER_START_CMD_JSON_WAN22_VIDEO_V2='["bash","-lc","exec bash /opt/allbot/runpod_bootstrap_from_git.sh"]'
RUNPOD_IMAGE_NAME_WAN22_VIDEO_V2=ghcr.io/giraffu/allbot-comfy-runpod-wan22-aio-video:20260619-wan22aio-rife-bcf3ebd
RUNPOD_USE_TEMPLATE_WAN22_VIDEO_V2=false
RUNPOD_MODEL_PREFIX_WAN22_VIDEO_V2=wan22_video_v2/2026-06-13-test
RUNPOD_MODEL_MANIFEST_KEY_WAN22_VIDEO_V2=wan22_video_v2/2026-06-13-test/manifest.json
RUNPOD_WAN22_VIDEO_V2_COMFY_EXTRA_ARGS=--disable-dynamic-vram
RUNPOD_WAN22_VIDEO_V2_COMPLETION_TIMEOUT_SECONDS=600
RUNPOD_WAN22_VIDEO_V2_EXIT_ON_TIMEOUT=true

# i2i_pro prod RunPod image/text/face-swap profile.
RUNPOD_DOCKER_START_CMD_JSON_I2I_PRO='["bash","-lc","exec bash /opt/allbot/runpod_bootstrap_from_git.sh"]'
RUNPOD_IMAGE_NAME_I2I_PRO=ghcr.io/giraffu/allbot-comfy-runpod-i2i-pro:20260614-i2ipro-b75c6a9-cu128-min5-ssh
RUNPOD_USE_TEMPLATE_I2I_PRO=false
RUNPOD_GPU_TYPE_IDS_I2I_PRO=NVIDIA GeForce RTX 4090
RUNPOD_MODEL_PREFIX_I2I_PRO=i2i_pro/2026-06-14-test
RUNPOD_MODEL_MANIFEST_KEY_I2I_PRO=i2i_pro/2026-06-14-test/manifest.json
RUNPOD_TASK_TYPE_WORKFLOW_OVERRIDES_I2I_PRO={"t2i-pornmaster-turbo":"txt2img_from_i2i_pro.json","face_swap_v2":"face_swap_v2.json"}

# SCAIL-2 prod RunPod video-to-video profile.
RUNPOD_DOCKER_START_CMD_JSON_SCAIL2='["bash","-lc","exec bash /opt/allbot/runpod_bootstrap_from_git.sh"]'
RUNPOD_IMAGE_NAME_SCAIL2=ghcr.io/giraffu/allbot-comfy-runpod-scail2:<prod-tag>
RUNPOD_USE_TEMPLATE_SCAIL2=false
RUNPOD_GPU_TYPE_IDS_SCAIL2=NVIDIA GeForce RTX 5090,NVIDIA GeForce RTX 4090
RUNPOD_MODEL_PREFIX_SCAIL2=scail2/2026-06-17-test
RUNPOD_MODEL_MANIFEST_KEY_SCAIL2=scail2/2026-06-17-test/manifest.json

# LTX 2.3 advanced image-to-video prod RunPod profile.
RUNPOD_DOCKER_START_CMD_JSON_LTX_VIDEO='["bash","-lc","exec bash /opt/allbot/runpod_bootstrap_from_git.sh"]'
RUNPOD_IMAGE_NAME_LTX_VIDEO=ghcr.io/giraffu/allbot-comfy-runpod-ltx-video:<prod-tag>
RUNPOD_USE_TEMPLATE_LTX_VIDEO=false
RUNPOD_GPU_TYPE_IDS_LTX_VIDEO="NVIDIA GeForce RTX 5090,NVIDIA GeForce RTX 4090"
RUNPOD_CONTAINER_DISK_GB_LTX_VIDEO=180
RUNPOD_MODEL_PREFIX_LTX_VIDEO=ltx_video/2026-06-10
RUNPOD_MODEL_MANIFEST_KEY_LTX_VIDEO=ltx_video/2026-06-10/manifest.json
RUNPOD_TASK_TYPE_WORKFLOW_OVERRIDES_LTX_VIDEO='{"ltx_video":"LTX 2.3 10Eros v1.2 I2V 6.1.json","ltx_video_flf2v":"LTX 2.3 10Eros v1.2 FLF2V 6.1.json","ltx_video_v2v_audio":"LTX 2.3 10Eros v1.2 V2V Audio 6.1.json"}'

# PornMaster Flux2 free-edit v2 prod RunPod profile.
RUNPOD_IMAGE_NAME_PORNMASTER_FLUX2_EDIT=ghcr.io/giraffu/allbot-comfy-runpod-pornmaster-flux2-edit:20260701-pornmaster-flux2-edit-14d2d88-local1
RUNPOD_USE_TEMPLATE_PORNMASTER_FLUX2_EDIT=false
RUNPOD_GPU_TYPE_IDS_PORNMASTER_FLUX2_EDIT=NVIDIA GeForce RTX 4090,NVIDIA L40S,NVIDIA GeForce RTX 5090
RUNPOD_CONTAINER_DISK_GB_PORNMASTER_FLUX2_EDIT=120
RUNPOD_MODEL_PREFIX_PORNMASTER_FLUX2_EDIT=pornmaster_flux2_edit/2026-06-27
RUNPOD_MODEL_MANIFEST_KEY_PORNMASTER_FLUX2_EDIT=pornmaster_flux2_edit/2026-06-27/manifest.json
