COPY src /app/src
COPY shared /app/shared
LABEL org.opencontainers.image.revision=$ALLBOT_GIT_SHA io.allbot.release.module=qqcc-config-backend
CMD ["gunicorn", "dashboard.backend.qqcc_config_main:app", "-w", "1", "-k", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8045"]
