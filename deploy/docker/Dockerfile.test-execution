ARG RUNTIME_BASE_IMAGE
FROM ${RUNTIME_BASE_IMAGE} AS python-worker-base
ARG ALLBOT_GIT_SHA
ARG ALLBOT_SOURCE=https://github.com/giraffu/All_bot
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY workers/worker_requirements.txt /tmp/worker-requirements.txt
RUN pip install --no-cache-dir -r /tmp/worker-requirements.txt
LABEL org.opencontainers.image.revision=$ALLBOT_GIT_SHA \
      org.opencontainers.image.source=$ALLBOT_SOURCE \
      io.allbot.release.layer=python-worker-base

FROM python-worker-base AS worker-agent
ARG ALLBOT_GIT_SHA
COPY workers/comfy_agent /app/worker
COPY src /app/src
COPY shared /app/shared
LABEL org.opencontainers.image.revision=$ALLBOT_GIT_SHA io.allbot.release.module=worker-agent
CMD ["python", "/app/worker/agent_main.py"]

FROM ${RUNTIME_BASE_IMAGE} AS worker-relay
ARG ALLBOT_GIT_SHA
ARG ALLBOT_SOURCE=https://github.com/giraffu/All_bot
COPY workers/local_relay /app/local_relay
COPY src /app/src
COPY shared /app/shared
LABEL org.opencontainers.image.revision=$ALLBOT_GIT_SHA \
      org.opencontainers.image.source=$ALLBOT_SOURCE \
      io.allbot.release.layer=worker-relay
CMD ["python", "/app/local_relay/relay_main.py"]
