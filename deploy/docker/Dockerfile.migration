ARG RUNTIME_BASE_IMAGE
FROM ${RUNTIME_BASE_IMAGE} AS database-migration
ARG ALLBOT_GIT_SHA
COPY src /app/src
COPY shared /app/shared
COPY scripts/history_media_r2_migration.py scripts/history_media_r2_copy_adaptive.py scripts/history_media_r2_cloud_copy.py scripts/history_media_r2_retirement.py scripts/media_archive_catalog.py scripts/media_archive_worker.py /app/scripts/
COPY alembic.ini /app/alembic.ini
COPY migrations /app/migrations
LABEL org.opencontainers.image.revision=$ALLBOT_GIT_SHA io.allbot.release.module=database-migration
ENTRYPOINT ["alembic"]
CMD ["upgrade", "head"]
