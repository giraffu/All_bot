ARG RUNTIME_BASE_IMAGE
FROM ${RUNTIME_BASE_IMAGE} AS python-media-runtime-base

ARG ALLBOT_GIT_SHA
ARG ALLBOT_SOURCE=https://github.com/giraffu/All_bot
LABEL org.opencontainers.image.revision=$ALLBOT_GIT_SHA \
      org.opencontainers.image.source=$ALLBOT_SOURCE \
      io.allbot.release.layer=python-media-runtime-base

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

COPY deploy/docker/media-intelligence-requirements.txt /tmp/media-intelligence-requirements.txt
RUN pip install --no-cache-dir -r /tmp/media-intelligence-requirements.txt

RUN mkdir -p /opt/allbot/models
ADD --checksum=sha256:8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4 \
    https://media.githubusercontent.com/media/opencv/opencv_zoo/47534e27c9851bb1128ccc0102f1145e27f23f98/models/face_detection_yunet/face_detection_yunet_2023mar.onnx \
    /opt/allbot/models/face_detection_yunet_2023mar.onnx
COPY deploy/docker/YUNET_LICENSE.txt /opt/allbot/models/LICENSE.yunet.txt
