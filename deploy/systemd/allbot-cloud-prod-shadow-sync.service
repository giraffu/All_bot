[Unit]
Description=AllBot cloud production data sync to local shadow copies
Documentation=file:__ALLBOT_ROOT__/docs/子模块_云正式控制面部署_cloud_prod_control_plane.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=__ALLBOT_USER__
Group=__ALLBOT_GROUP__
WorkingDirectory=__ALLBOT_ROOT__
ExecStart=/usr/bin/env python3 __ALLBOT_ROOT__/scripts/sync_cloud_prod_to_local_shadow.py --execute --env-file __ALLBOT_ROOT__/.env.cloud-prod-shadow-sync.local
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=12h
PrivateTmp=true
NoNewPrivileges=true
