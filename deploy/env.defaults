# Versioned, non-secret runtime defaults. Environment files override these.
TZ=Asia/Shanghai
MINIO_SECURE=false
PREFETCH_ENABLED=true
PREFETCH_DEPTH=1
PIPELINE_ENABLED=true
PIPELINE_MAX_RUNNING_TASKS=2
PRIVATE_QQCC_BOT_ENABLED=false
TON_PAYMENT_POLLING_ENABLED=false
USDT_TON_PAYMENT_ENABLED=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
R2_MAX_POOL_CONNECTIONS=100
R2_EXISTS_POSITIVE_TTL_SECONDS=60
R2_EXISTS_NEGATIVE_TTL_SECONDS=5
R2_EXISTS_CACHE_MAX_ENTRIES=5000
R2_HEAD_SEMAPHORE_LIMIT=32
R2_HEAD_CONNECT_TIMEOUT_SECONDS=2
R2_HEAD_READ_TIMEOUT_SECONDS=3
R2_HEAD_MAX_ATTEMPTS=1
POLL_INTERVAL=2
POLL_TIMEOUT=180
ENABLE_PUBLIC_SHARE=false
ENABLE_FREE_EDIT_V2=false
ENABLE_SCAIL2_LONG_ACTION_TRANSFER=false
LTX_T2V_BACKEND_ENABLED=false
LTX_T2V_MSR_ENABLED=false
ENABLE_LTX_VIDEO_V2=false
MINIMAX_H3_PROMPT_OPTIMIZER_ENABLED=false
DAILY_LIMIT=10
ORDER_V2_ENABLED=false
AFFILIATE_MEMBERSHIP_REDEEM_ENABLED=false
MEMBERSHIP_SETTLEMENT_V2_ENABLED=false
PAID_GROUP_DECLINE_UNQUALIFIED=false
PAID_GROUP_DRY_RUN=false
PAID_GROUP_BOT_CONNECT_TIMEOUT=60
PAID_GROUP_BOT_READ_TIMEOUT=60
PAID_GROUP_BOT_WRITE_TIMEOUT=60
PAID_GROUP_BOT_POOL_SIZE=20
PAID_GROUP_BOT_POLL_INTERVAL=2
PAID_GROUP_BOT_POLL_TIMEOUT=30
PAID_GROUP_BOT_LOG_FILE=/app/logs/paid_group_guard_bot.log
PAID_GROUP_MODERATION_CONFIG_FILE=/app/runtime/paid-group-guard/config.json
PAID_GROUP_MODERATION_LOG_FILE=/app/logs/paid_group_moderation.jsonl
GROUP_MANAGE_BOT_CONNECT_TIMEOUT=60
GROUP_MANAGE_BOT_READ_TIMEOUT=60
GROUP_MANAGE_BOT_WRITE_TIMEOUT=60
GROUP_MANAGE_BOT_POOL_SIZE=20
GROUP_MANAGE_BOT_POLL_INTERVAL=2
GROUP_MANAGE_BOT_POLL_TIMEOUT=30
GROUP_MANAGE_BOT_LOG_FILE=/app/logs/group_manage_bot.log
GROUP_MANAGE_MODERATION_CONFIG_FILE=/app/runtime/group-manage/config.json
GROUP_MANAGE_MODERATION_LOG_FILE=/app/logs/group_manage_moderation.jsonl
