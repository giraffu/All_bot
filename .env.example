# Telegram Bot Token
BOT_TOKEN=your_bot_token_here

# API Configuration
API_BASE=http://127.0.0.1:8003

# Proxy Configuration (Optional)
# PROXY_URL=socks5://127.0.0.1:7890

# Permission Control
# 根管理员ID，用逗号分隔 (可以使用 /root 命令管理权限)
ADMIN_USERS=12345678,87654321

# 静态允许的用户ID，用逗号分隔 (例如管理员)
ALLOWED_USERS=12345678,87654321

# 静态允许的群组ID，用逗号分隔 (机器人在这些群里可用，且这些群的成员私聊机器人也可用)
ALLOWED_GROUPS=-100123456789,-100987654321

# 拒绝访问时的提示语
JOIN_MESSAGE=🚫 您没有权限使用此机器人。\n请加入官方群组 [My Group](https://t.me/example) 后重试。
