{
  "license_notes": {
    "seedvr2_reference": "ComfyUI workflow templates media-other 0.3.120 (MIT)",
    "rife_reference": "Existing AllBot FL_RIFE integration and offline rife49 cache contract"
  },
  "workflows": {
    "image_upscale": {
      "file": "image_upscale.api.json",
      "multipliers": [2, 4],
      "source_node": "1",
      "source_input": "image",
      "resolution_node": "4",
      "resolution_input": "resolution",
      "output_node": "5"
    },
    "video_upscale": {
      "file": "video_upscale.api.json",
      "multipliers": [2],
      "source_node": "1",
      "source_input": "video",
      "resolution_node": "4",
      "resolution_input": "resolution",
      "output_node": "5",
      "preserves_audio": true
    },
    "frame_interpolation": {
      "file": "frame_interpolation.api.json",
      "multipliers": [2, 4],
      "source_node": "1",
      "source_input": "video",
      "multiplier_node": "2",
      "multiplier_input": "multiplier",
      "output_node": "3",
      "preserves_audio": true
    }
  }
}
