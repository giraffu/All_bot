{
  "1": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "__SOURCE_FILE__",
      "force_rate": 0,
      "force_size": "Disabled",
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "2": {
    "class_type": "SeedVR2LoadDiTModel",
    "inputs": {
      "model": "seedvr2_ema_7b_fp16.safetensors",
      "device": "cuda:0",
      "blocks_to_swap": 0,
      "cache_model": false,
      "offload_device": "cpu",
      "use_fp8": false,
      "attention_mode": "sdpa"
    }
  },
  "3": {
    "class_type": "SeedVR2LoadVAEModel",
    "inputs": {
      "model": "ema_vae_fp16.safetensors",
      "device": "cuda:0",
      "encode_tiled": false,
      "encode_tile_size": 1024,
      "encode_tile_overlap": 128,
      "decode_tiled": false,
      "decode_tile_size": 1024,
      "decode_tile_overlap": 128,
      "offload_device": "cpu"
    }
  },
  "4": {
    "class_type": "SeedVR2VideoUpscaler",
    "inputs": {
      "image": ["1", 0],
      "dit": ["2", 0],
      "vae": ["3", 0],
      "resolution": 2160,
      "seed": 1,
      "batch_size": 5,
      "color_correction": "lab"
    }
  },
  "5": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["4", 0],
      "audio": ["1", 2],
      "frame_rate": 30,
      "loop_count": 0,
      "filename_prefix": "clarity/video_upscale",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
