# Copy to .env and replace every CHANGE_ME value before starting.
CLARITY_WEB_PORT=8095
CLARITY_ALLOWED_ORIGINS=["http://localhost:8095"]
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
MINIO_ROOT_USER=clarity
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO
CLARITY_JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET
CLARITY_AGENT_TOKEN=CHANGE_ME_RANDOM_AGENT_TOKEN
CLARITY_ADMIN_EMAIL=admin@example.com
CLARITY_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# Optional: only used with `docker compose --profile test-worker up`.
CLARITY_TEST_WORKER_BRIDGE_WORKER_ID=clarity-allbot-test-bridge
CLARITY_TEST_CENTRAL_URL=
CLARITY_TEST_CENTRAL_API_TOKEN=
CLARITY_TEST_INPUT_S3_ENDPOINT_URL=
CLARITY_TEST_INPUT_S3_ACCESS_KEY=
CLARITY_TEST_INPUT_S3_SECRET_KEY=
CLARITY_TEST_INPUT_S3_BUCKET=user-data-test
CLARITY_TEST_INPUT_S3_REGION=us-east-1
