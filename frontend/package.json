{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "build": "vue-tsc -b && vite build",
    "build:release": "vue-tsc -b && vite build --mode release",
    "build:cf-prod": "vue-tsc -b && vite build --mode cf-prod",
    "build:cf-test": "vue-tsc -b && vite build --mode cf-test",
    "contract:check": "python3 ../scripts/generate_task_type_contract.py --check",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@ton/core": "^0.63.1",
    "@tonconnect/ui": "^2.4.4",
    "@vueuse/core": "^14.2.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.15.0",
    "dayjs": "^1.11.20",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.32",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.4",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.6",
    "vue-waterfall-plugin-next": "^3.0.1",
    "wrangler": "4.110.0"
  }
}
