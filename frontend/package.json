{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "build": "vue-tsc -b && vite build",
    "build:edge-test": "vue-tsc -b && vite build --mode edge-test",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "deploy": "npm run deploy:edge-prod",
    "deploy:edge-prod": "sh ./scripts/deploy-edge-prod.sh",
    "deploy:edge-test": "sh ./scripts/deploy-edge-test.sh"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@ton/core": "^0.63.1",
    "@tonconnect/ui": "^2.4.4",
    "@vueuse/core": "^14.2.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.15.0",
    "dayjs": "^1.11.20",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.32",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.4",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.6",
    "vue-waterfall-plugin-next": "^3.0.1"
  }
}
