# Copy this file to worker_remote_01.relay.env and fill real values on the
# remote worker host. Do not commit real .env files.

REMOTE_WORKER_ID=worker_remote_01

# Dedicated Cloudflare Tunnel hostname for Central API 8003.
# Do not use api.aivison.it.com, and do not add a trailing /api.
CENTRAL_API_URL=https://worker-central.example.com
AGENT_SECRET_TOKEN=replace_with_cloud_prod_agent_secret_token

LOCAL_RELAY_HOST=127.0.0.1
LOCAL_RELAY_PORT=8013
LOCAL_RELAY_LOG_LEVEL=INFO
RELAY_REQUEST_TIMEOUT_SECONDS=30
RELAY_REQUEST_RETRY_ATTEMPTS=3
RELAY_STATUS_FLUSH_INTERVAL_SECONDS=0.5

RESULT_SPOOL_DIR=./spool/worker_remote_01
SPOOL_ORPHAN_MAX_AGE_SECONDS=21600
UPLOAD_SIDECAR_RETRY_ATTEMPTS=3
UPLOAD_SIDECAR_RETRY_BASE_SECONDS=0.5

# R2 S3-compatible endpoint host. Prefer host-only form; https:// is tolerated.
MINIO_ENDPOINT=replace_with_account_id.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=replace_with_r2_access_key
MINIO_SECRET_KEY=replace_with_r2_secret_key
MINIO_SECURE=true

# The bundled agent loads this file as its base env, then optionally loads
# worker_remote_01.agent.env for ComfyUI/task-type overrides.
