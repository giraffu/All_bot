# Optional patch values for the existing old comfy agent on worker_remote_02.
# Copy the needed keys into that worker's real agent .env.

AGENT_ID=worker_remote_02
MASTER_API_URL=http://127.0.0.1:8013
UPLOAD_SIDECAR_URL=http://127.0.0.1:8013
RESULT_SPOOL_DIR=./spool/worker_remote_02

AGENT_SECRET_TOKEN=replace_with_cloud_prod_agent_secret_token
SUPPORTED_TASK_TYPES=img2img

# Keep these pointed at the local ComfyUI that this old worker already used.
COMFY_API_URL=http://127.0.0.1:8111/
COMFY_WS_URL=ws://127.0.0.1:8111/ws
COMFY_INPUT_DIR=./input
COMFY_OUTPUT_DIR=./output

# Cloud prod object storage. New results must write to R2/user-data-prod.
MINIO_ENDPOINT=replace_with_account_id.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=replace_with_r2_access_key
MINIO_SECRET_KEY=replace_with_r2_secret_key
MINIO_INPUT_BUCKET=user-data-prod
MINIO_RESULT_BUCKET=user-data-prod
MINIO_TEMPLATE_BUCKET=user-data-prod
MINIO_SECURE=true

# Keep old agents conservative unless you have confirmed they support these.
PREFETCH_ENABLED=false
PIPELINE_ENABLED=false
CANCEL_LOCK_ON_POP=true

