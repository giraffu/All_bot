ARG BASE_IMAGE=192.168.1.115:5000/allbot/comfy-runpod-ltx-t2v@sha256:124cd638cab69e87c39946190a7e17169b6223e35c7d946e9df540719ddb385b
FROM ${BASE_IMAGE}

ARG ALLBOT_GIT_SHA
LABEL org.opencontainers.image.revision=$ALLBOT_GIT_SHA \
      io.allbot.runpod.agent-revision=$ALLBOT_GIT_SHA \
      io.allbot.runpod.workflow-revision=$ALLBOT_GIT_SHA \
      io.allbot.runpod.runtime-base-digest="sha256:124cd638cab69e87c39946190a7e17169b6223e35c7d946e9df540719ddb385b"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY remote_workers /opt/allbot/runtime/remote_workers
COPY remote_workers/scripts/runpod_bootstrap_from_git.sh /opt/allbot/runpod_bootstrap_from_git.sh
COPY remote_workers/scripts/runpod_baked_runtime_entrypoint.sh /opt/allbot/runpod_baked_runtime_entrypoint.sh

RUN set -euo pipefail; \
    chmod +x /opt/allbot/runpod_bootstrap_from_git.sh /opt/allbot/runpod_baked_runtime_entrypoint.sh; \
    comfyui_dir="$(cat /opt/allbot-comfyui-dir)"; \
    test -f "${comfyui_dir}/main.py"; \
    for node_name in ComfyUI-KJNodes ComfyUI-LTXVideo ComfyUI-VideoHelperSuite allbot_ltx_min_nodes rgthree-comfy; do \
      test -d "${comfyui_dir}/custom_nodes/${node_name}"; \
    done; \
    python3 -c 'import fastapi, minio, uvicorn, websockets'; \
    PYTHONPATH=/opt/allbot/runtime/remote_workers python3 -c 'from comfy_agent.workflow_task_patchers import TASK_SPECIFIC_PATCHERS as p; assert {"ltx_t2v","ltx_t2v_ic"} <= set(p)'; \
    python3 -c 'import json; from pathlib import Path; root=Path("/opt/allbot/runtime/remote_workers/comfy_agent/workflows"); expected={"LTX 2.3 Sulphur T2V.json","LTX 2.3 Sulphur Ingredients T2V.json"}; graphs={name:json.loads((root/name).read_text()) for name in expected}; assert all(graph["26:39"]["inputs"]["width"] in {384,640} for graph in graphs.values()); ic=graphs["LTX 2.3 Sulphur Ingredients T2V.json"]; assert ic["26:91"]["inputs"]["latent"] == ["26:153",0] and ic["26:149"]["inputs"]["latents"] == ["26:95",0]'; \
    if find "${comfyui_dir}/models" -type f -name "*.safetensors" -print -quit | grep -q .; then \
      echo "LTX model files must stay out of the runtime refresh image" >&2; \
      exit 1; \
    fi

ENV ALLBOT_RUNPOD_REPO_DIR=/opt/allbot/runtime \
    ALLBOT_RUNPOD_REMOTE_WORKERS_DIR=/opt/allbot/runtime/remote_workers
CMD ["bash", "/opt/allbot/runpod_baked_runtime_entrypoint.sh"]
