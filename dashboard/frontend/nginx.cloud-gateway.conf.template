proxy_cache_path /var/cache/nginx/dashboard_stats
    levels=1:2
    keys_zone=dashboard_stats_cache:10m
    max_size=64m
    inactive=2m
    use_temp_path=off;

proxy_cache_path /var/cache/nginx/dashboard_system
    levels=1:2
    keys_zone=dashboard_system_cache:10m
    max_size=32m
    inactive=1m
    use_temp_path=off;

limit_req_zone $binary_remote_addr zone=dashboard_auth_limit:10m rate=2r/s;
# cloudflared may multiplex many Telegram users through one origin address.
# Owner tickets are 256-bit, one-time, and Redis-backed, so use a separate
# bounded burst budget instead of the administrator login's narrow IP bucket.
limit_req_zone $binary_remote_addr zone=private_bot_ticket_limit:10m rate=50r/s;

map $http_host $dashboard_csp {
    default "default-src 'self'; connect-src 'self' https: http:; img-src 'self' data: blob: https: http:; media-src 'self' blob: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';";
}

map $http_host $private_bot_owner_csp {
    default "default-src 'self'; connect-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; frame-ancestors 'self' https://*.telegram.org https://telegram.org; base-uri 'self'; form-action 'self';";
}

map $request_method $dashboard_no_cache_method {
    default 1;
    GET 0;
    HEAD 0;
}

upstream dashboard_backend {
    server ${DASHBOARD_BACKEND_HOST};
    keepalive 16;
}

# Unknown Host values must never fall through to the administrator application.
server {
    listen ${DASHBOARD_GATEWAY_PORT} default_server;
    server_name _;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy $dashboard_csp always;
    return 404;
}

# Public owner console. Keep this host isolated from every administrator route.
server {
    listen ${DASHBOARD_GATEWAY_PORT};
    server_name ${PRIVATE_QQCC_BOT_OWNER_HOST};

    server_tokens off;
    client_max_body_size 4k;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types application/javascript application/json image/svg+xml text/css text/plain;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    # X-Frame-Options is intentionally omitted: Telegram clients embed this WebApp.
    add_header Content-Security-Policy $private_bot_owner_csp always;

    location = /index.private-bot.html {
        root /usr/share/nginx/html;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy $private_bot_owner_csp always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location = /index.html {
        return 404;
    }

    location = /index.qqcc-config.html {
        return 404;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy $private_bot_owner_csp always;
        add_header Cache-Control "public, immutable" always;
        access_log off;
    }

    location ~ ^/api/private-bots/owner/auth/exchange$ {
        client_max_body_size 4k;
        limit_req zone=private_bot_ticket_limit burst=500 nodelay;
        limit_req_status 429;

        proxy_pass http://dashboard_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy $private_bot_owner_csp always;
        add_header Cache-Control "no-store" always;
    }

    location = /api/private-bots/owner/config {
        client_max_body_size 1m;

        proxy_pass http://dashboard_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy $private_bot_owner_csp always;
        add_header Cache-Control "no-store" always;
    }

    location = /api/private-bots/owner/credentials {
        client_max_body_size 4k;

        proxy_pass http://dashboard_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy $private_bot_owner_csp always;
        add_header Cache-Control "no-store" always;
    }

    location ~ ^/api/private-bots/owner/demo-media/ {
        client_max_body_size 55m;

        proxy_pass http://dashboard_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy $private_bot_owner_csp always;
        add_header Cache-Control "no-store" always;
    }

    location ~ ^/api/private-bots/owner(?:/|$) {
        client_max_body_size 4k;
        proxy_pass http://dashboard_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy $private_bot_owner_csp always;
        add_header Cache-Control "no-store" always;
    }

    location /api/ {
        return 404;
    }

    location / {
        root /usr/share/nginx/html;
        try_files /index.private-bot.html =404;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy $private_bot_owner_csp always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }
}

server {
    listen ${DASHBOARD_GATEWAY_PORT};
    server_name ${QQCC_CONFIG_ADMIN_HOST};

    server_tokens off;
    client_max_body_size 20m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types
        application/javascript
        application/json
        image/svg+xml
        text/css
        text/plain;

    allow 127.0.0.1;
    allow ::1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    allow 100.64.0.0/10;
    deny all;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy $dashboard_csp always;

    location = /index.html {
        root /usr/share/nginx/html;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy $dashboard_csp always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy $dashboard_csp always;
        add_header Cache-Control "public, immutable" always;
        access_log off;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy $dashboard_csp always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location ~ ^/api/auth/(login|bind-password) {
        limit_req zone=dashboard_auth_limit burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://dashboard_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy $dashboard_csp always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location ~ ^/api/stats(?:/|$) {
        proxy_pass http://dashboard_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_cache dashboard_stats_cache;
        proxy_cache_methods GET HEAD;
        proxy_cache_key "$scheme|$request_method|$host|$request_uri|$http_authorization";
        proxy_cache_lock on;
        proxy_cache_lock_timeout 30s;
        proxy_cache_lock_age 30s;
        proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
        proxy_cache_valid 200 60s;
        proxy_ignore_headers Cache-Control Expires;
        proxy_cache_bypass $dashboard_no_cache_method $arg__t;
        proxy_no_cache $dashboard_no_cache_method;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy $dashboard_csp always;
        add_header X-Dashboard-Cache $upstream_cache_status;
        add_header Cache-Control "private, max-age=60";
    }

    location ~ ^/api/system/(status|workers|concurrency_stats)$ {
        proxy_pass http://dashboard_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_cache dashboard_system_cache;
        proxy_cache_methods GET HEAD;
        proxy_cache_key "$scheme|$request_method|$host|$request_uri|$http_authorization";
        proxy_cache_valid 200 5s;
        proxy_ignore_headers Cache-Control Expires;
        proxy_cache_bypass $dashboard_no_cache_method $arg__t;
        proxy_no_cache $dashboard_no_cache_method;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy $dashboard_csp always;
        add_header X-Dashboard-Cache $upstream_cache_status;
        add_header Cache-Control "private, max-age=5";
    }

    location ~ ^/api/qqcc/demo-media/ {
        client_max_body_size 55m;

        proxy_pass http://dashboard_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy $dashboard_csp always;
        add_header Cache-Control "no-store" always;
    }

    location /api/ {
        proxy_pass http://dashboard_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy $dashboard_csp always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }
}
