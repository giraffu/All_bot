# Copy to avatar_miniapp/.env.lan and replace every CHANGE_ME value.
ALLBOT_ENV=test
MINIAPP_LAN_HOST=192.168.1.20
MINIAPP_HTTPS_PORT=8443
MINIAPP_FIXTURE_MODE=true

# Use the same test credentials as the main AllBot web service.
DATABASE_URL=postgresql+asyncpg://CHANGE_ME@host.docker.internal:5432/CHANGE_ME
REDIS_URL=redis://host.docker.internal:6379/0
REDIS_PREFIX=allbot:test
JWT_SECRET_KEY=CHANGE_ME

MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=CHANGE_ME
MINIO_RESULT_BUCKET=CHANGE_ME
MINIO_TEMPLATE_BUCKET=CHANGE_ME
MINIO_SECURE=false
MINIO_PUBLIC_URL=https://192.168.1.20:9000

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
R2_MAX_POOL_CONNECTIONS=10
R2_EXISTS_POSITIVE_TTL_SECONDS=300
R2_EXISTS_NEGATIVE_TTL_SECONDS=30
R2_EXISTS_CACHE_MAX_ENTRIES=1000
R2_HEAD_SEMAPHORE_LIMIT=8
R2_HEAD_CONNECT_TIMEOUT_SECONDS=2
R2_HEAD_READ_TIMEOUT_SECONDS=5
R2_HEAD_MAX_ATTEMPTS=2
POLL_INTERVAL=2
POLL_TIMEOUT=900
DAILY_LIMIT=10
ENABLE_PUBLIC_SHARE=false
